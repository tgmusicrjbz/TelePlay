# =========================================
# TelePlay - Backend Configuration
# =========================================

# -----------------------------------------
# TELEGRAM CONFIGURATION (Required)
# -----------------------------------------

# Get API ID and Hash from https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=your_bot_token

# (Optional) Helper bots for faster download speeds (comma-separated tokens)
# IMPORTANT: All helper bots MUST be added as Administrators to your Storage Channel!
TELEGRAM_HELPER_BOT_TOKENS=token1,token2,token3

# (Optional) User session used for background YouTube/Instagram imports.
# Generate locally with: python scripts/init_worker.py
TELEGRAM_WORKER_SESSION=
# Optional additional user sessions for parallel imports. Separate sessions
# with commas; each account needs to have opened @allsaverbot at least once.
TELEGRAM_WORKER_SESSIONS=

# Create a private channel, add your bot as admin, and get the channel ID
# Channel IDs start with -100 (e.g., -1001234567890)
TELEGRAM_STORAGE_CHANNEL_ID=-100xxxxxxxxxx

# (Optional) Comma separated Telegram IDs of authorized users.
# Leave empty to allow everyone to use the bot.
AUTH_USERS=

# Telegram IDs allowed to open the user-management panel.
# If empty, the first AUTH_USERS entry is used as administrator.
ADMIN_USERS=

# -----------------------------------------
# GEMINI TEXT TO SPEECH (Optional)
# -----------------------------------------
# One or more server-side Google AI Studio keys. Separate multiple keys with
# commas. Keys from the same Google project share the same project quota.
GEMINI_API_KEYS=
# Override only when Google publishes a newer compatible TTS model.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_STT_MODEL=gemini-3.8-flash

# -----------------------------------------
# SECURITY (Required)
# -----------------------------------------

# Secret key for JWT tokens - use a long random string (min 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-in-production

# Token expiry in minutes (default: 10080 = 7 days)
JWT_EXPIRY_MINUTES=10080

# -----------------------------------------
# DATABASE
# -----------------------------------------

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/teleplay

# SQLite (no PostgreSQL setup needed — great for small/local deployments)
DATABASE_URL=sqlite:///./data/teleplay.db
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0


# -----------------------------------------
# SERVER
# -----------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# -----------------------------------------
# WEB INTERFACE
# -----------------------------------------

# Public URL where the web app is accessible
# Used for generating links in bot messages
WEB_BASE_URL=http://localhost:5173

# Optional Google Drive account connection. Create an OAuth 2.0 Web client in
# Google Cloud Console and add GOOGLE_REDIRECT_URI to its authorized redirects.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/files/drive/oauth/callback
# Separate public OAuth client using drive.file plus Google Picker.
GOOGLE_PICKER_CLIENT_ID=
GOOGLE_PICKER_CLIENT_SECRET=
GOOGLE_PICKER_REDIRECT_URI=http://localhost:5173/api/files/drive/oauth/callback
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
