# Local API against the primary database, while Railway stays online.
# Copying this to .env.local is optional: the setup script creates it safely.
# Never commit .env.local.

# Keep local workers off. Railway remains the sole owner of Telegram, Drive,
# link-import, TTS/STT and scheduled-monitor workers.
KOMOD_LOCAL_DEV=true

# Paste the primary PostgreSQL connection URI here only on your own computer.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# The Vite frontend runs here in local development.
WEB_BASE_URL=http://localhost:5173
