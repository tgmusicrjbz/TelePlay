{
  "name": "کمد؛ درایو ابری تلگرام",
  "short_name": "کمد",
  "description": "درایو ابری تلگرام برای ذخیره، جست‌وجو، پخش و مرتب‌سازی همه فایل‌ها",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "background_color": "#07090f",
  "theme_color": "#7c3aed",
  "categories": ["productivity", "utilities", "entertainment"],
  "icons": [
    {
      "src": "/komod-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/komod-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/komod-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
